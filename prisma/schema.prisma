/// 主題實踐打卡記錄表
/// CHECK 約束說明（需在資料庫層手動維護）:
/// - mood: CHECK ("mood" IN ('give_up', 'frustrated', 'bored', 'neutral', 'good', 'happy'))
/// - image_urls: CHECK (array_length("image_urls", 1) <= 3 OR "image_urls" IS NULL)
model practice_checkins {
  id           Int       @id @default(autoincrement())
  practice_id  Int
  user_id      Int
  checkin_date DateTime  @db.Date
  /// 允許值: give_up, frustrated, bored, neutral, good, happy
  mood         String?   @db.VarChar(20)
  /// 詳細描述（最多300字）
  note         String?   @db.VarChar(300)
  /// 打卡圖片 URL，最多 3 張
  image_urls   String[]
  /// OG 圖片 URL（用於社群分享）
  og_image_url String?   @db.VarChar(500)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @db.Timestamptz(6)
  practices    practices @relation(fields: [practice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([checkin_date], map: "idx_practice_checkins_date")
  @@index([practice_id], map: "idx_practice_checkins_practice_id")
  @@index([user_id], map: "idx_practice_checkins_user_id")
}

/// Letters that users schedule for delivery to their future selves.
/// The database CHECK constraint restricts status to draft, scheduled, delivered, or deleted.
model future_letters {
  id                      Int        @id @default(autoincrement())
  external_id             String     @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 Int
  current_self            String?
  message                 String?
  content_ciphertext      Bytes?
  encryption_iv           Bytes?
  encryption_auth_tag     Bytes?
  encryption_version      String?    @db.VarChar(32)
  status                  String     @default("draft") @db.VarChar(20)
  deliver_at              DateTime?  @db.Timestamptz(6)
  sent_at                 DateTime?  @db.Timestamptz(6)
  delivered_at            DateTime?  @db.Timestamptz(6)
  opened_at               DateTime?  @db.Timestamptz(6)
  practice_id             Int?
  practice_title_snapshot String?
  created_at              DateTime   @default(now()) @db.Timestamptz(6)
  updated_at              DateTime   @default(now()) @db.Timestamptz(6)
  practices               practices? @relation(fields: [practice_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  users                   users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_future_letters_user_id")
  @@index([status, deliver_at], map: "idx_future_letters_status_deliver_at")
}

