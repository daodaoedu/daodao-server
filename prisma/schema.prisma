generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model basic_info {
  id                Int                 @id @default(autoincrement())
  self_introduction String?
  share_list        String?
  want_to_do_list   want_to_do_list_t[]
  users             users[]
}

model categories {
  id                                                Int          @id @default(autoincrement())
  name                                              String       @unique @db.VarChar(100)
  parent_id                                         Int?
  description                                       String?
  created_at                                        DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at                                        DateTime?    @default(now()) @db.Timestamptz(6)
  categories                                        categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_categories                                  categories[] @relation("categoriesTocategories")
  resources_resources_major_category_idTocategories resources[]  @relation("resources_major_category_idTocategories")
  resources_resources_sub_category_idTocategories   resources[]  @relation("resources_sub_category_idTocategories")

  @@index([name], map: "idx_categories_name")
  @@index([parent_id], map: "idx_categories_parent_id")
}

model city {
  id       Int        @id @default(autoincrement())
  name     city_t?
  groups   groups[]
  location location[]

  @@index([name], map: "idx_city_name")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model comments {
  id             Int        @id @default(autoincrement())
  target_id      Int
  user_id        Int
  content        String
  visibility     String?    @default("private") @db.VarChar(10)
  parent_id      Int?
  created_at     DateTime?  @default(now()) @db.Timestamp(6)
  updated_at     DateTime?  @default(now()) @db.Timestamp(6)
  target_type    String     @default("post") @db.VarChar(20)
  comments       comments?  @relation("commentsTocomments", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_comments comments[] @relation("commentsTocomments")
  users          users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([target_type, target_id], map: "idx_comments_target")
  @@index([user_id], map: "idx_comments_user")
  @@index([visibility], map: "idx_comments_visibility")
}

model contacts {
  id                 Int      @id @default(autoincrement())
  google_id          String?  @db.VarChar(255)
  photo_url          String?
  is_subscribe_email Boolean?
  email              String?  @db.VarChar(255)
  ig                 String?  @db.VarChar(255)
  discord            String?  @db.VarChar(255)
  line               String?  @db.VarChar(255)
  fb                 String?  @db.VarChar(255)
  users              users[]
}

model country {
  id       Int        @id @default(autoincrement())
  alpha2   String?    @unique(map: "idx_country_alpha2") @db.Char(2)
  alpha3   String?    @unique(map: "idx_country_alpha3") @db.Char(3)
  name     String     @db.VarChar(100)
  location location[]
}

model eligibility {
  id                  Int                @id @default(autoincrement())
  reference_file_path String?
  partner_emails      String[]
  fee_plans_id        Int?
  created_at          DateTime?          @default(now()) @db.Timestamp(6)
  updated_at          DateTime?          @default(now()) @db.Timestamp(6)
  fee_plans           fee_plans?         @relation(fields: [fee_plans_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project_marathon    project_marathon[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model entity_resources {
  id          Int       @id @default(autoincrement())
  external_id String?   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource_id Int
  entity_type String    @db.VarChar(20)
  entity_id   Int
  created_by  Int
  note        String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  users       users     @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
  resources   resources @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([resource_id, entity_type, entity_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model entity_tags {
  id          Int       @id @default(autoincrement())
  entity_type String    @db.VarChar(50)
  entity_id   Int
  tag_id      Int
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
  created_by  Int?
  users       users?    @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  tags        tags      @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([entity_type, entity_id, tag_id])
  @@index([created_at], map: "idx_entity_tags_created_at")
  @@index([tag_id], map: "idx_entity_tags_tag_id")
  @@index([entity_type, entity_id], map: "idx_entity_tags_type_entity")
}

model fee_plans {
  id            Int               @id @default(autoincrement())
  fee_plan_type qualifications_t?
  name          String?           @db.VarChar(255)
  discount      Decimal?          @db.Decimal(8, 2)
  created_at    DateTime?         @default(now()) @db.Timestamp(6)
  updated_at    DateTime?         @default(now()) @db.Timestamp(6)
  eligibility   eligibility[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model groups {
  id                     Int                        @id @default(autoincrement())
  external_id            String?                    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                  String?
  photo_url              String?                    @db.VarChar(255)
  photo_alt              String?                    @db.VarChar(255)
  category               group_category_t[]
  group_type             group_type_t[]
  partner_education_step partner_education_step_t[]
  description            String?                    @db.VarChar(255)
  city_id                Int?
  is_grouping            Boolean?
  created_date           DateTime?                  @db.Timestamptz(6)
  updated_date           DateTime?                  @db.Timestamptz(6)
  time                   String?
  partner_style          String?
  created_at             DateTime?                  @db.Timestamptz(6)
  created_by             Int?
  updated_at             DateTime?                  @db.Timestamptz(6)
  updated_by             String?                    @db.VarChar(255)
