// ─── Learner Persona ──────────────────────────────────────────────────────────

enum persona_question_type_t {
  choice
  sentence_completion
  scenario
}

model persona_questions {
  id                   Int                     @id @default(autoincrement())
  question_type        persona_question_type_t
  is_new_user_priority Boolean                 @default(false)
  created_at           DateTime                @default(now()) @db.Timestamptz(6)

  persona_answers               persona_answers[]
  persona_skips                 persona_skips[]
  persona_question_translations persona_question_translations[]
}

model persona_question_translations {
  id          Int    @id @default(autoincrement())
  question_id Int
  locale      String @db.VarChar(10)
  prompt      String
  options     Json?

  persona_questions persona_questions @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([question_id, locale], map: "uq_persona_question_translations_question_locale")
  @@index([locale], map: "idx_persona_question_translations_locale")
}

model persona_answers {
  id             Int       @id @default(autoincrement())
  user_id        Int
  question_id    Int
  selected_value String?   @db.VarChar(500)
  text_answer    String?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @db.Timestamptz(6)

  users             users             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  persona_questions persona_questions @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([user_id, question_id], map: "uq_persona_answers_user_question")
  @@index([user_id], map: "idx_persona_answers_user_id")
  @@index([question_id], map: "idx_persona_answers_question_id")
}

model persona_skips {
  id          Int       @id @default(autoincrement())
  user_id     Int
  question_id Int
  skip_count  Int       @default(0)
  suppressed  Boolean   @default(false)
  updated_at  DateTime? @db.Timestamptz(6)

  users             users             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  persona_questions persona_questions @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([user_id, question_id], map: "uq_persona_skips_user_question")
  @@index([user_id], map: "idx_persona_skips_user_id")
}

model persona_user_state {
  user_id                         Int       @id
  session_count_since_last_prompt Int       @default(0)
  last_prompt_timestamp           DateTime? @db.Timestamptz(6)
  last_dismissed_at               DateTime? @db.Timestamptz(6)
  created_at                      DateTime  @default(now()) @db.Timestamptz(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model roadmap_items {
  id            Int                     @id @default(autoincrement())
  external_id   String                  @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String                  @db.VarChar(255)
  description   String
  category      String                  @db.VarChar(20)
  status        String                  @default("collected") @db.VarChar(20)
  support_count Int                     @default(0)
  is_public     Boolean                 @default(true)
  pinned        Boolean                 @default(false)
  sort_order    Int                     @default(0)
  shipped_at    DateTime?               @db.Timestamptz(6)
  created_at    DateTime                @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                @default(now()) @db.Timestamptz(6)
  wishes        wishes[]
  supports      roadmap_item_supports[]

  @@index([status], map: "idx_roadmap_items_status")
  @@index([is_public, status], map: "idx_roadmap_items_public_status")
  @@index([category], map: "idx_roadmap_items_category")
}

model wishes {
  id                     Int            @id @default(autoincrement())
  category               String         @db.VarChar(20)
  situation              String
  desire                 String
  submitter_user_id      Int
  contact_email          String?        @db.VarChar(255)
  status                 String         @default("pending") @db.VarChar(20)
  linked_roadmap_item_id Int?
  internal_module_tag    String?        @db.VarChar(50)
  source                 String         @default("web") @db.VarChar(10)
  created_at             DateTime       @default(now()) @db.Timestamptz(6)
  updated_at             DateTime       @default(now()) @db.Timestamptz(6)
  submitter              users          @relation(fields: [submitter_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_wishes_submitter")
  linked_item            roadmap_items? @relation(fields: [linked_roadmap_item_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_wishes_linked_item")

  @@index([status], map: "idx_wishes_status")
  @@index([category], map: "idx_wishes_category")
  @@index([submitter_user_id], map: "idx_wishes_submitter")
  @@index([linked_roadmap_item_id], map: "idx_wishes_linked_item")
}

model roadmap_item_supports {
  id              Int           @id @default(autoincrement())
  roadmap_item_id Int
  user_id         Int
  origin          String        @default("vote") @db.VarChar(20)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  roadmap_item    roadmap_items @relation(fields: [roadmap_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ris_item")
  user            users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ris_user")

  @@unique([roadmap_item_id, user_id], map: "uq_roadmap_item_supports")
  @@index([roadmap_item_id], map: "idx_ris_item")
  @@index([user_id], map: "idx_ris_user")
}

// ─── Survey ───────────────────────────────────────────────────────────────────

enum survey_status_t {
  draft
  active
  closed
  archived
}

enum question_type_t {
  multiple_choice
  single_choice
  rating
  text
  yesno
  scale
  ranking
}

model surveys {
  id            Int             @id @default(autoincrement())
  external_id   String          @unique @default(dbgenerated("gen_random_uuid()::text"))
  title         String
  description   String?
  status        survey_status_t @default(draft)
  is_public     Boolean         @default(true)
  is_anonymous  Boolean         @default(false)
  max_responses Int?
  tags          String[]        @default([])
  cover_url     String?
  view_count    Int             @default(0)
  created_by    Int
  start_time    DateTime?       @db.Timestamptz(6)
  end_time      DateTime?       @db.Timestamptz(6)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @updatedAt @db.Timestamptz(6)

  questions           questions[]
  responses           survey_responses[]
  partial_submissions survey_partial_submissions[]
  cohort_feedback     cohort_feedback_surveys?

  @@index([created_by], map: "idx_surveys_created_by")
  @@index([status], map: "idx_surveys_status")
}

model questions {
  id            Int             @id @default(autoincrement())
  survey_id     Int
  question_type question_type_t
  question_text String
  is_required   Boolean         @default(false)
  position      Int             @default(0)
  conditions    Json            @default("[]") @db.JsonB
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @updatedAt @db.Timestamptz(6)

  survey  surveys            @relation(fields: [survey_id], references: [id], onDelete: Cascade)
  options question_options[]
  answers survey_answers[]

  feedback_answers cohort_feedback_answers[]

  @@unique([survey_id, id], map: "uq_questions_survey_id_id")
  @@index([survey_id], map: "idx_questions_survey_id")
}

model question_options {
  id          Int      @id @default(autoincrement())
  question_id Int
  option_text String
  position    Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  question questions @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([question_id], map: "idx_question_options_question_id")
}

model survey_responses {
  id           Int       @id @default(autoincrement())
  survey_id    Int
  user_id      Int?
  started_at   DateTime? @db.Timestamptz(6)
  completed_at DateTime  @default(now()) @db.Timestamptz(6)

  survey  surveys          @relation(fields: [survey_id], references: [id], onDelete: Cascade)
  answers survey_answers[]

  @@index([survey_id], map: "idx_survey_responses_survey_id")
  @@index([user_id], map: "idx_survey_responses_user_id")
}

model survey_partial_submissions {
  id            Int      @id @default(autoincrement())
  survey_id     Int
  session_key   String
  last_position Int      @default(0)
  started_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  survey surveys @relation(fields: [survey_id], references: [id], onDelete: Cascade)

  @@unique([survey_id, session_key])
  @@index([survey_id, last_position], map: "idx_partial_submissions_survey_position")
}

model survey_answers {
  id                  Int             @id @default(autoincrement())
  survey_response_id  Int
  survey_id           Int
  question_id         Int
  question_type       question_type_t
  answer_text         String?
  selected_option_ids Int[]           @default([])
  rating_value        Int?
  boolean_value       Boolean?

  response survey_responses @relation(fields: [survey_response_id], references: [id], onDelete: Cascade)
  question questions        @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([survey_response_id], map: "idx_survey_answers_response_id")
  @@index([survey_id, question_id], map: "idx_survey_answers_survey_question")
}

/// 燈塔組織；個人講師以單成員組織表示。
model organization {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @db.VarChar(100)
  bio                  String?
  external_link        String?
  status               String                 @default("active") @db.VarChar(20)
  approved_by          Int?
  approved_at          DateTime?              @db.Timestamptz(6)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  approver             users?                 @relation(fields: [approved_by], references: [id], onUpdate: NoAction, map: "fk_organization_approved_by")
  timezone             String                 @default("Asia/Taipei") @db.VarChar(64)
  updated_at           DateTime?              @db.Timestamptz(6)
  /// 島島阿學官方組織（共同挑戰所屬組織）；partial unique index 保證最多一筆 true（daodao#179）
  is_official          Boolean                @default(false)
  cohort_message_templates cohort_message_templates[]
  organization_members organization_members[]
  practice_templates   practice_templates[]
  programs             programs[]
  ai_credentials       organization_ai_credentials?
}

/// 帶領人訊息範本；組織內共享，分「鼓勵 encourage」「慶祝 celebrate」兩類（FR-TF-06）
model organization_ai_credentials {
  id                  Int          @id @default(autoincrement())
  organization_id     Int          @unique(map: "uq_organization_ai_credentials_organization")
  provider            String       @default("openai") @db.VarChar(50)
  api_key_ciphertext  Bytes?
  encryption_iv       Bytes?
  encryption_auth_tag Bytes?
  encryption_version  String?      @db.VarChar(32)
  key_last4           String?      @db.VarChar(4)
  status              String       @default("unset") @db.VarChar(20)
  last_tested_at      DateTime?    @db.Timestamptz(6)
  last_test_error     String?
  updated_by          Int?
  created_at          DateTime     @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?    @db.Timestamptz(6)
  organization        organization @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_organization_ai_credentials_organization")
  updater             users?       @relation(fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_organization_ai_credentials_updated_by")
}

model cohort_outcome_summaries {
  id             Int       @id @default(autoincrement())
  cohort_id      Int
  version        Int
  source         String    @db.VarChar(20)
  content        String
  is_current     Boolean   @default(true)
  provider       String?   @db.VarChar(50)
  model_name     String?   @db.VarChar(200)
  prompt_version String?   @db.VarChar(32)
  input_range    Json?
  usage          Json?
  generated_at   DateTime? @db.Timestamptz(6)
  created_by     Int?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  cohort         cohorts   @relation(fields: [cohort_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cohort_outcome_summaries_cohort")
  creator        users?    @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_cohort_outcome_summaries_created_by")

  @@unique([cohort_id, version], map: "uq_cohort_outcome_summaries_version")
}

model cohort_message_templates {
  id              Int               @id @default(autoincrement())
  organization_id Int
  created_by      Int?
  category        String            @db.VarChar(20)
  title           String            @db.VarChar(100)
  body            String
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?         @db.Timestamptz(6)
  deleted_at      DateTime?         @db.Timestamptz(6)
  cohort_messages cohort_messages[]
  creator         users?            @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_cohort_message_templates_created_by")
  organization    organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cohort_message_templates_organization")

  @@index([organization_id, category], map: "idx_cohort_message_templates_org_category")
}

/// 帶領人對參與者送出的訊息（鼓勵／慶祝）；以參與者為軸，不綁單則打卡（FR-TF-05/06）
model cohort_messages {
  id                Int                       @id @default(autoincrement())
  cohort_id         Int
  sender_user_id    Int?
  recipient_user_id Int?
  practice_id       Int?
  template_id       Int?
  category          String                    @db.VarChar(20)
  body              String
  sent_at           DateTime                  @default(now()) @db.Timestamptz(6)
  cohort            cohorts                   @relation(fields: [cohort_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cohort_messages_cohort")
  practice          practices?                @relation(fields: [practice_id], references: [id], onUpdate: NoAction, map: "fk_cohort_messages_practice")
  recipient         users?                    @relation("CohortMessageRecipient", fields: [recipient_user_id], references: [id], onUpdate: NoAction, map: "fk_cohort_messages_recipient")
  sender            users?                    @relation("CohortMessageSender", fields: [sender_user_id], references: [id], onUpdate: NoAction, map: "fk_cohort_messages_sender")
  template          cohort_message_templates? @relation(fields: [template_id], references: [id], onUpdate: NoAction, map: "fk_cohort_messages_template")

  @@index([cohort_id, recipient_user_id, sent_at(sort: Desc)], map: "idx_cohort_messages_cohort_recipient_sent")
}

/// 組織成員；是否存在此關係即為燈塔登入門檻。
model organization_members {
  id              Int          @id @default(autoincrement())
  organization_id Int
  user_id         Int
  role            String       @default("owner") @db.VarChar(20)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  organization    organization @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_organization_members_organization")
  user            users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_organization_members_user")

  @@unique([organization_id, user_id], map: "uq_organization_members_organization_user")
  @@index([user_id], map: "idx_organization_members_user")
}

/// 燈塔系列；無時間屬性的期容器。
model programs {
  id              Int          @id @default(autoincrement())
  organization_id Int
  name            String       @db.VarChar(100)
  description     String?
  kind            String       @default("lighthouse") @db.VarChar(20)
  deleted_at      DateTime?    @db.Timestamptz(6)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?    @db.Timestamptz(6)
  archived_at     DateTime?    @db.Timestamptz(6)
  archived_by     Int?
  cohorts         cohorts[]
  organization    organization @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_programs_organization")
  archiver        users?       @relation("programs_archived_by", fields: [archived_by], references: [id], onUpdate: NoAction, map: "fk_programs_archived_by")

  @@index([organization_id], map: "idx_programs_organization_id")
}

/// 燈塔的期；status 僅表示 draft、published、archived 編輯狀態。
model cohorts {
  id                    Int                     @id @default(autoincrement())
  program_id            Int
  slug                  String                  @db.VarChar(50)
  display_name          String                  @db.VarChar(100)
  start_date            DateTime                @db.Date
  end_date              DateTime                @db.Date
  join_token            String?                 @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 暫停透過邀請連結加入；TRUE 時連結暫時無效但 token 保留，重新開放沿用原連結
  join_paused           Boolean                 @default(false)
  join_deadline         DateTime?               @db.Date
  capacity              Int?
  invite_message        String?
  status                String                  @default("draft") @db.VarChar(20)
  /// 探索活動頁可見性：private | public；值域由 server 常量管控，僅 programs.kind=lighthouse 使用
  visibility                     String                  @default("private") @db.VarChar(20)
  /// 一句話簡介（≤80 字），顯示於探索卡與報名頁
  tagline                        String?                 @db.VarChar(80)
  /// 互動方式多選：sync | async | physical；值域由 server 常量管控
  interaction_modes              String[]                @default([])
  timezone                       String                  @default("Asia/Taipei") @db.VarChar(64)
  meeting_url                    String?
  location                       String?                 @db.VarChar(200)
  /// free | paid；paid 時 signup_method 必為 external
  fee_type                       String                  @default("free") @db.VarChar(10)
  fee_amount                     Int?
  /// island_form | external；值域由 server 常量管控
  signup_method                  String                  @default("island_form") @db.VarChar(20)
  external_signup_url            String?
  /// 私密活動：TRUE 時 cohort 實踐 privacy_status 為 private
  is_private                     Boolean                 @default(true)
  /// 參與者打卡預設私密（本輪僅存值，強制行為另案）
  checkin_default_private         Boolean                 @default(false)
  /// 發起人留言預設私密（本輪僅存值，強制行為另案）
  host_comment_default_private    Boolean                 @default(false)
  show_invite_message_on_signup   Boolean                 @default(false)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @db.Timestamptz(6)
  cohort_enrollments    cohort_enrollments[]
  cohort_messages       cohort_messages[]
  cohort_stat_snapshots cohort_stat_snapshots[]
  cohort_templates      cohort_templates[]
  inspiration_deck_assignments inspiration_deck_assignments[]
  inspiration_draws     inspiration_draws[]
  practices             practices[]
  program               programs                @relation(fields: [program_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cohorts_program")
  cohort_sessions       cohort_sessions[]
  chat_room             chat_rooms?
  archived_at           DateTime?  @db.Timestamptz(6)
  archived_by           Int?
  archived_from_status  String?    @db.VarChar(20)
  archived_reason       String?    @db.VarChar(20)
  deleted_at            DateTime?  @db.Timestamptz(6)
  archiver              users?     @relation("cohorts_archived_by", fields: [archived_by], references: [id], onUpdate: NoAction, map: "fk_cohorts_archived_by")
  outcome_summaries     cohort_outcome_summaries[]
  feedback_survey      cohort_feedback_surveys?

  @@unique([program_id, slug], map: "uq_cohorts_program_slug")
  @@index([program_id], map: "idx_cohorts_program_id")
  @@index([end_date], map: "idx_cohorts_public_published_end_date")
  @@index([program_id, archived_at], map: "idx_cohorts_archived")
}

/// 靈感卡卡組：admin 建立，可重複 assign 給不同共同挑戰。
model inspiration_decks {
  id          Int                            @id @default(autoincrement())
  name        String                         @db.VarChar(100)
  created_by  Int?
  deleted_at  DateTime?                      @db.Timestamptz(6)
  created_at  DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?                      @db.Timestamptz(6)
  creator     users?                         @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_inspiration_decks_created_by")
  cards       inspiration_deck_cards[]
  assignments inspiration_deck_assignments[]
}

/// 靈感卡卡片：純文字內容，最多 50 字。
model inspiration_deck_cards {
  id         Int                 @id @default(autoincrement())
  deck_id    Int
  content    String              @db.VarChar(50)
  sort_order Int                 @default(0)
  deleted_at DateTime?           @db.Timestamptz(6)
  created_at DateTime            @default(now()) @db.Timestamptz(6)
  updated_at DateTime?           @db.Timestamptz(6)
  deck       inspiration_decks   @relation(fields: [deck_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inspiration_deck_cards_deck")
  draws      inspiration_draws[]

  @@index([deck_id], map: "idx_inspiration_deck_cards_deck_id")
}

/// 卡組與共同挑戰期的指派；解除以 unassigned_at 表示。
model inspiration_deck_assignments {
  id            Int               @id @default(autoincrement())
  deck_id       Int
  cohort_id     Int
  assigned_at   DateTime          @default(now()) @db.Timestamptz(6)
  unassigned_at DateTime?         @db.Timestamptz(6)
  deck          inspiration_decks @relation(fields: [deck_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inspiration_deck_assignments_deck")
  cohort        cohorts           @relation(fields: [cohort_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inspiration_deck_assignments_cohort")

  @@unique([deck_id, cohort_id], map: "uq_inspiration_deck_assignments_deck_cohort")
  @@index([cohort_id], map: "idx_inspiration_deck_assignments_cohort_id")
}

/// 抽卡記錄：每日上限 3 次與已選排除依此表計算（Asia/Taipei 日界）。
model inspiration_draws {
  id          Int                    @id @default(autoincrement())
  user_id     Int
  cohort_id   Int
  card_id     Int
  drawn_on    DateTime               @db.Date
  is_selected Boolean                @default(false)
  created_at  DateTime               @default(now()) @db.Timestamptz(6)
  user        users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inspiration_draws_user")
  cohort      cohorts                @relation(fields: [cohort_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inspiration_draws_cohort")
  card        inspiration_deck_cards @relation(fields: [card_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inspiration_draws_card")

  @@index([user_id, cohort_id, drawn_on], map: "idx_inspiration_draws_user_cohort_drawn_on")
}

/// 期邀請與參與關係；email 是聯絡紀錄，身分以 token 綁定。
model cohort_enrollments {
  id                 Int       @id @default(autoincrement())
  cohort_id          Int
  email              String?   @db.VarChar(255)
  user_id            Int?
  invite_token       String?   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status             String    @default("invited") @db.VarChar(20)
  role               String    @default("member") @db.VarChar(20)
  invited_at         DateTime  @default(now()) @db.Timestamptz(6)
  joined_at          DateTime? @db.Timestamptz(6)
  exited_at          DateTime? @db.Timestamptz(6)
  export_opt_in      Boolean   @default(false)
  export_opted_in_at DateTime? @db.Timestamptz(6)
  cohort             cohorts   @relation(fields: [cohort_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cohort_enrollments_cohort")
  user               users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_cohort_enrollments_user")

  @@unique([cohort_id, email], map: "uq_cohort_enrollments_cohort_email")
  @@index([cohort_id, status], map: "idx_enrollments_cohort_status")
  @@index([user_id], map: "idx_enrollments_user")
}

/// 模板與期的綁定歷程；解綁以 unbound_at 表示。
model cohort_templates {
  id                Int                @id @default(autoincrement())
  cohort_id         Int
  template_id       Int
  bound_at          DateTime           @default(now()) @db.Timestamptz(6)
  unbound_at        DateTime?          @db.Timestamptz(6)
  /// 此綁定產生的實踐草稿開始日；NULL 時回退為該期的 start_date
  start_date        DateTime?          @db.Date
  cohort            cohorts            @relation(fields: [cohort_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cohort_templates_cohort")
  practice_template practice_templates @relation(fields: [template_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cohort_templates_template")

  resources_initialized_at DateTime?                   @db.Timestamptz(6)
  cohort_template_resources cohort_template_resources[]
  @@unique([cohort_id, template_id], map: "uq_cohort_templates_cohort_template")
}

/// 期的週次與期末聚合快照，不含個人識別資訊。
model cohort_stat_snapshots {
  id           Int      @id @default(autoincrement())
  cohort_id    Int
  period_start DateTime @db.Date
  kind         String   @default("weekly") @db.VarChar(20)
  metrics      Json
  computed_at  DateTime @default(now()) @db.Timestamptz(6)
  cohort       cohorts  @relation(fields: [cohort_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cohort_stat_snapshots_cohort")

  @@unique([cohort_id, kind, period_start], map: "uq_cohort_stat_snapshots_period")
}

/// Invite-based event-course spaces (issue #151 空間頁面).
/// Personal-practice and platform-challenge spaces are virtual aggregates
/// assembled at the API layer and have no rows here.
model spaces {
  id               Int                @id @default(autoincrement())
  external_id      String             @unique(map: "uq_spaces_external_id") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_user_id    Int
  name             String             @db.VarChar(100)
  subtitle         String?            @db.VarChar(100)
  public_token     String?            @unique(map: "uq_spaces_public_token") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status           String             @default("active") @db.VarChar(20)
  last_activity_at DateTime           @default(now()) @db.Timestamptz(6)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?          @db.Timestamptz(6)
  deleted_at       DateTime?          @db.Timestamptz(6)
  users            users              @relation(fields: [owner_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_spaces_owner")
  space_members    space_members[]
  space_practices  space_practices[]
  space_home_pages space_home_pages?

  @@index([owner_user_id], map: "idx_spaces_owner_user_id")
}

/// Space membership roster; the host row marks the space initiator (FR-1.3).
model space_members {
  id         Int      @id @default(autoincrement())
  space_id   Int
  user_id    Int
  role       String   @default("member") @db.VarChar(20)
  joined_at  DateTime @default(now()) @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  spaces     spaces   @relation(fields: [space_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_space_members_space")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_space_members_user")

  @@unique([space_id, user_id], map: "uq_space_members_space_user")
  @@index([user_id], map: "idx_space_members_user_id")
  @@index([space_id], map: "idx_space_members_space_id")
}

/// Links theme practices into a space; source for the sub-page practice list (FR-4.2).
model space_practices {
  id          Int       @id @default(autoincrement())
  space_id    Int
  practice_id Int
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  spaces      spaces    @relation(fields: [space_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_space_practices_space")
  practices   practices @relation(fields: [practice_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_space_practices_practice")

  @@unique([space_id, practice_id], map: "uq_space_practices_space_practice")
  @@index([space_id], map: "idx_space_practices_space_id")
  @@index([practice_id], map: "idx_space_practices_practice_id")
}

/// Space home page; UNIQUE(space_id) enforces at most one page per space (FR-3.8).
/// The database CHECK constraint restricts status to draft or published.
model space_home_pages {
  id           Int            @id @default(autoincrement())
  space_id     Int            @unique(map: "uq_space_home_pages_space_id")
  status       String         @default("draft") @db.VarChar(20)
  published_at DateTime?      @db.Timestamptz(6)
  created_by   Int
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?      @db.Timestamptz(6)
  spaces       spaces         @relation(fields: [space_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_space_home_pages_space")
  users        users          @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_space_home_pages_created_by")
  space_blocks space_blocks[]
}

/// Home page content blocks (text / resources / calendar) with per-block
/// draft / scheduled / published lifecycle (FR-7.x); body is text-type only.
model space_blocks {
  id                 Int                 @id @default(autoincrement())
  page_id            Int
  block_type         String              @db.VarChar(20)
  title              String              @default("") @db.VarChar(200)
  body               String?
  position           Int                 @default(0)
  is_pinned          Boolean             @default(false)
  publish_status     String              @default("draft") @db.VarChar(20)
  scheduled_at       DateTime?           @db.Timestamptz(6)
  published_at       DateTime?           @db.Timestamptz(6)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?           @db.Timestamptz(6)
  space_home_pages   space_home_pages    @relation(fields: [page_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_space_blocks_page")
  space_block_links  space_block_links[]
  space_block_events space_block_events[]

  @@index([page_id, position], map: "idx_space_blocks_page_position")
}

/// Resource-block link rows (name + url); auto-naming only overwrites
/// names the host has not customized (FR-8.6).
model space_block_links {
  id                         Int                          @id @default(autoincrement())
  block_id                   Int
  name                       String                       @default("") @db.VarChar(200)
  url                        String
  is_name_customized         Boolean                      @default(false)
  position                   Int                          @default(0)
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime?                    @db.Timestamptz(6)
  space_blocks               space_blocks                 @relation(fields: [block_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_space_block_links_block")
  space_block_link_practices space_block_link_practices[]

  @@index([block_id, position], map: "idx_space_block_links_block_position")
}

/// Multi-select mapping between a resource link row and practices (FR-8.8);
/// the mapping is annotation-only and never cascades edits (FR-8.12).
model space_block_link_practices {
  id                Int               @id @default(autoincrement())
  link_id           Int
  practice_id       Int
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  space_block_links space_block_links @relation(fields: [link_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_space_block_link_practices_link")
  practices         practices         @relation(fields: [practice_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_space_block_link_practices_practice")

  @@unique([link_id, practice_id], map: "uq_space_block_link_practices_link_practice")
  @@index([practice_id], map: "idx_space_block_link_practices_practice_id")
}

/// Calendar-block event rows; only the start date is required (FR-9.1).
model space_block_events {
  id           Int          @id @default(autoincrement())
  block_id     Int
  title        String       @default("") @db.VarChar(200)
  start_date   DateTime     @db.Date
  end_date     DateTime?    @db.Date
  start_time   DateTime?    @db.Time(6)
  end_time     DateTime?    @db.Time(6)
  location     String?      @db.VarChar(200)
  url          String?
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?    @db.Timestamptz(6)
  space_blocks space_blocks @relation(fields: [block_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_space_block_events_block")

  @@index([block_id, start_date], map: "idx_space_block_events_block_date")
}

/// 場次聚會時段（FR-BS-03）；僅 interaction_modes 含 sync/physical 時有列
model cohort_sessions {
  id           Int      @id @default(autoincrement())
  cohort_id    Int
  session_date DateTime @db.Date
  start_time   DateTime? @db.Time(6)
  end_time     DateTime? @db.Time(6)
  recurrence_group_id String? @db.Uuid
  recurrence_rule     Json? @db.JsonB
  position     Int      @default(0)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  cohort       cohorts  @relation(fields: [cohort_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cohort_sessions_cohort")

  @@index([cohort_id, session_date, position], map: "idx_cohort_sessions_cohort_date")
}

/// 活動課程群組聊天室；與 cohort 一對一，僅 programs.kind=lighthouse 建立
model chat_rooms {
  id              Int              @id @default(autoincrement())
  cohort_id       Int              @unique(map: "uq_chat_rooms_cohort")
  last_message_at DateTime?        @db.Timestamptz(6)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?        @db.Timestamptz(6)
  cohort          cohorts          @relation(fields: [cohort_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_rooms_cohort")
  chat_messages   chat_messages[]
  chat_room_reads chat_room_reads[]

  @@index([last_message_at(sort: Desc)], map: "idx_chat_rooms_last_message_at")
}

model chat_messages {
  id                  Int                  @id @default(autoincrement())
  room_id             Int
  sender_user_id      Int?
  kind                String               @default("text") @db.VarChar(20)
  body                String
  metadata            Json?
  reply_to_message_id Int?
  pinned_at           DateTime?            @db.Timestamptz(6)
  pinned_by_user_id   Int?
  edited_at           DateTime?            @db.Timestamptz(6)
  deleted_at          DateTime?            @db.Timestamptz(6)
  deleted_by_user_id  Int?
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  /// 任何可見變動（編輯、刪除、置頂、按讚計數）都會更新，供增量輪詢 since 使用
  updated_at          DateTime             @default(now()) @db.Timestamptz(6)
  room                chat_rooms           @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_messages_room")
  sender              users?               @relation("ChatMessageSender", fields: [sender_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_chat_messages_sender")
  reply_to            chat_messages?       @relation("ChatMessageReply", fields: [reply_to_message_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_chat_messages_reply_to")
  replies             chat_messages[]      @relation("ChatMessageReply")
  pinned_by           users?               @relation("ChatMessagePinnedBy", fields: [pinned_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_chat_messages_pinned_by")
  deleted_by          users?               @relation("ChatMessageDeletedBy", fields: [deleted_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_chat_messages_deleted_by")
  chat_message_likes  chat_message_likes[]

  @@index([room_id, id], map: "idx_chat_messages_room_id_id")
  @@index([room_id, updated_at], map: "idx_chat_messages_room_updated")
  @@index([reply_to_message_id], map: "idx_chat_messages_reply_to")
}

model chat_message_likes {
  id         Int           @id @default(autoincrement())
  message_id Int
  user_id    Int
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  message    chat_messages @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_message_likes_message")
  user       users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_message_likes_user")

  @@unique([message_id, user_id], map: "uq_chat_message_likes_message_user")
  @@index([user_id], map: "idx_chat_message_likes_user")
}

/// 每人每室的已讀游標；未讀 = id > last_read_message_id 且非本人、未刪除的訊息數
model chat_room_reads {
  id                   Int        @id @default(autoincrement())
  room_id              Int
  user_id              Int
  last_read_message_id Int?
  last_read_at         DateTime   @default(now()) @db.Timestamptz(6)
  room                 chat_rooms @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_room_reads_room")
  user                 users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_room_reads_user")

  @@unique([room_id, user_id], map: "uq_chat_room_reads_room_user")
  @@index([user_id], map: "idx_chat_room_reads_user")
}

/// 期末問卷版本及全場次寄送狀態；不含填答者資訊。
model cohort_feedback_surveys {
  cohort_id Int @id
  survey_id Int @unique
  format_version Int @default(1)
  delivery_state String @default("pending") @db.VarChar(20)
  delivery_started_at DateTime? @db.Timestamptz(6)
  delivered_at DateTime? @db.Timestamptz(6)
  cohort cohorts @relation(fields: [cohort_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  survey surveys @relation(fields: [survey_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  completions cohort_feedback_completions[]
  answers cohort_feedback_answers[]
}

/// 只記錄完成身分，不連結答案或記錄提交時間。
model cohort_feedback_completions {
  cohort_id Int
  user_id Int
  feedback cohort_feedback_surveys @relation(fields: [cohort_id], references: [cohort_id], onDelete: Cascade, onUpdate: NoAction)
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([cohort_id, user_id])
}

/// 按題獨立儲存匿名答案；無填答者、提交批次、時間或遞增序號。
model cohort_feedback_answers {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  survey_id Int
  question_id Int
  rating_value Int?
  answer_text String?
  feedback cohort_feedback_surveys @relation(fields: [survey_id], references: [survey_id], onDelete: Cascade, onUpdate: NoAction)
  question questions @relation(fields: [survey_id, question_id], references: [survey_id, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_feedback_answer_question")
  @@index([survey_id, question_id], map: "idx_feedback_answers_survey_question")
}

model cohort_template_resources {
  id                          Int @id @default(autoincrement())
  cohort_template_id          Int
  resource_id                 Int @unique
  source_template_relation_id Int?
  resource_date               DateTime? @db.Date
  sort_order                  Int
  created_at                  DateTime @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime? @db.Timestamptz(6)
  deleted_at                  DateTime? @db.Timestamptz(6)
  cohort_templates            cohort_templates @relation(fields: [cohort_template_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resources                   resources @relation(fields: [resource_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source_template_relation    entity_resources? @relation("cohort_template_resources_source_template_relation_idToentity_resources", fields: [source_template_relation_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  practice_relations          entity_resources[] @relation("entity_resources_cohort_template_resource_idTocohort_template_resources")
}
