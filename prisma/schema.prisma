  user_join_group        user_join_group[]

  @@index([TBD], map: "idx_group_TBD")
  @@index([city_id], map: "idx_group_city_id")
  @@index([group_type], map: "idx_group_group_type")
  @@index([is_grouping], map: "idx_group_is_grouping")
  @@index([is_online], map: "idx_group_is_online")
  @@index([partner_education_step], map: "idx_group_partner_education_step")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
