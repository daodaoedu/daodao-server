# Future Letter authenticated encryption (AES-256-GCM)
# Keep previous versions in the JSON keyring while rows still reference them.
# Generate a key with: openssl rand -base64 32
FUTURE_LETTER_ACTIVE_KEY_VERSION=v1
FUTURE_LETTER_ENCRYPTION_KEYS={"v1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}

# 燈塔組織自帶 AI API key 的 AES-256-GCM keyring（migration 089 organization_ai_credentials）
# 未設定時退回 FUTURE_LETTER_* 同一組 key；正式環境建議獨立一組：openssl rand -base64 32
# LIGHTHOUSE_AI_CREDENTIAL_ACTIVE_KEY_VERSION=v1
# LIGHTHOUSE_AI_CREDENTIAL_ENCRYPTION_KEYS={"v1":"<base64 32 bytes>"}

# daodao-ai-backend（燈塔 AI 成果摘要、鼓勵草稿）；本機 OrbStack 開發環境為 http://localhost:8002
# AI_BACKEND_URL=http://localhost:8002
# 服務間認證 token（與 ai-backend 的 API_SECRET_KEY 相同；ai-backend 會另外驗證轉發的使用者 JWT）
# AI_BACKEND_SERVICE_TOKEN=

# dev 測試登入端點（POST /api/v1/auth/dev-login）
# 只在 NODE_ENV=dev／development 且此值非空時掛載；prod 不要設定。產生：openssl rand -base64 32
# 部署時由 CD 從 GitHub environment secret DEV_LOGIN_SECRET 寫入 .env.dev，prod 一律移除
# DEV_LOGIN_SECRET=

# 共同挑戰所屬的島島阿學組織 id（organization.id；daodao#179）
# 後台建立／管理共同挑戰一律用這個組織，未設定或組織不存在時 API 回 409（fail closed）
# CHALLENGE_ORGANIZATION_ID=
