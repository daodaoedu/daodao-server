{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@types/*": ["src/types/*"],
      "@services/*": ["src/services/*"],
      "@middleware/*": ["src/middleware/*"],
      "@utils/*": ["src/utils/*"],
      "@models/*": ["src/models/*"],
      "@controllers/*": ["src/controllers/*"]
    },
    "allowJs": true,
    "declaration": false,
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types", "./src/types", "./src/types/declarations"],
    "types": ["node", "express", "jest"]
  },
  "include": [
    "src/**/*",
    "models/**/*",
    "services/**/*",
    "controllers/**/*",
    "routes/**/*",
    "validators/**/*",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}