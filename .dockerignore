# 版本控制
.git
.gitignore

# 依賴模組
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 環境變數檔案
.env*
!.env.example

# 日誌檔案
logs
*.log

# 運行時檔案
pids
*.pid
*.seed

# 測試相關
coverage
.nyc_output

# IDE 和編輯器
.vscode
.idea
*.swp
*.swo
*~

# 暫存檔案
.tmp
.cache

# 作業系統檔案
.DS_Store
Thumbs.db

# Docker 相關
Dockerfile*
docker-compose*
.dockerignore

# 說明文件 (可選，依需求決定)
README.md
*.md
docs/

# CI/CD
.github/

# 測試檔案
**/*.test.js
**/*.test.ts
**/*.spec.js
**/*.spec.ts

# 開發工具配置
.eslintrc*
.prettierrc*
tsconfig*.json
jest.config.js

# 備份檔案
backup_*
*.sql

# 建構輸出 (會在容器內重新建構)
dist/
build/

# 暫存和快取
.npm
.cache