# prod 環境變數範本：複製成 .env.prod 後填入實際值。
# 本檔會進版控，只能放佔位符，不可寫入任何真實連線字串或金鑰。
PORT=
NODE_ENV=prod
APP_ENV=
LOG_LEVEL=info
WINSTON_CONSOLE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
SESSION_SECRET=
JWT_SECRET=
JWT_EXPIRATION=
FRONTEND_URL=
ADMIN_FRONTEND_URL=
EMAIL_ADDRESS=
EMAIL_PASSWORD=
R2_BUCKET_NAME=
R2_REGION=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
REDIS_HOST=

# Future Letter 加密金鑰（必填，未設定 server 無法啟動；格式見 .env.example）
# 部署時由 CD 從 GitHub secret 寫入
FUTURE_LETTER_ACTIVE_KEY_VERSION=v1
FUTURE_LETTER_ENCRYPTION_KEYS=

# PostgreSQL Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB

# Prisma Configuration
PRISMA_CLIENT_ENGINE_TYPE=library
PRISMA_CLIENT_ENGINE_DIR=generated/prisma
PRISMA_DB_PULL_FORCE=false
PRISMA_GENERATE_SKIP_DOWNLOAD=true
PRISMA_CLI_BINARY_TARGETS=native

DOCKER_HUB_USERNAME=
DOCKER_TAG=
CONTAINER_NAME=
